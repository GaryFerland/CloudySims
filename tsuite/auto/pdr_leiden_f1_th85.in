title Leiden meeting model 1
# This is one of the tests in Rollig et al. 2007, A&A, 467, 187 
#
# commands controlling continuum =========
# Use the Draine 1978 field, for a semi-infinite slab we have to use half
# the requested value, so the actual value
# they want for the model is actually twice the value below
table draine 5
extinguish 24
#
# commands for density & abundances =========
#  hydrogen density 
hden 3.
grains ism 1.16 no qheat
#
# commands controlling geometry  =========
#
# other commands for details     =========
failures 3
# use leiden initialization file
init file="pdr_leiden.ini"
# This command defines the grain temperature to be a constant 20 Kelvin
constant grain temperature 20 
# This sets the temperature to a constant 50 Kelvin
constant temperature 50 linear
set H2 small model TH85
#
# commands controlling output    =========
print line optical depths 
save performance "pdr_leiden_f1_th85.per"
save overview "pdr_leiden_f1_th85.ovr"
save continuum "pdr_leiden_f1_th85.con"
save leiden lines "pdr_leiden_f1_th85.lin"
save leiden "pdr_leiden_f1_th85.lei"
save dr "pdr_leiden_f1_th85.dr" 
save molecules "pdr_leiden_f1_th85.mol"
save grain physical conditions "pdr_leiden_f1_th85.grn"
save monitors "pdr_leiden_f1_th85.asr"
save chemistry rates "pdr_leiden_f1_th85.COr" "CO"
save chemistry rates "pdr_leiden_f1_th85.H2r" "H2"
save chemistry rates "pdr_leiden_f1_th85.H2a" "H2" all
save chemistry rates "pdr_leiden_f1_th85.H2ds" "H2" destruction
save chemistry rates "pdr_leiden_f1_th85.H2cr" "H2" creation
save chemistry rates "pdr_leiden_f1_th85.H2ca" "H2" catalytic 
save secondaries "pdr_leiden_f1_th85.sec"
save species column densities "pdr_leiden_f1_th85.col" all
#
# commands giving the monitors    =========
## >> chng 20 sep 06 change default error to acknowledge stability of ISM chemistry
monitor set error 0.1
##
monitor line luminosity "Si 2" 34.8046m  -7.101
## >>chng 26 nov 04, from 14 to 13.22, initial update of the monitors
monitor "H2O " 538.142m line intensity -8.676
monitor "HNC " 1652.90m  line intensity -7.889 
monitor "HCS+" 1755.88m  -8.233 line intensity
monitor "CS  " 3058.86m  -7.348 line intensity
monitor "CO  " 2600.05m  -7.281 line intensity
monitor "CO  " 1300.05m  -6.455 line intensity
monitor "CO  " 866.727m  -6.139 line intensity
monitor "CO  " 650.074m  -6.213 line intensity
monitor "CO  " 520.089m  -6.529 line intensity
monitor "CO  " 433.438m  -7 line intensity
monitor "CO  " 371.549m  -7.524 line intensity
monitor "CO  " 325.137m  -8.094 line intensity
monitor "^13CO" 906.599m  -7.557 line intensity
monitor "CN  " 880.858m  -7.915  line intensity
# 
monitor H2 column density 21.904 error 0.1
